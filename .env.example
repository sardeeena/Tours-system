# Awesome Adventure Tours production application
# Copy this file to .env for local development.
# In Hostinger, add the same variables in the Node.js application environment settings.
# Never commit a real .env file or place server secrets in any VITE_* variable.

NODE_ENV=development
# Hostinger normally injects PORT automatically. The app defaults to 3000 locally.
# PORT=3000

# Supabase project (production is pinned in the application to this project ref).
SUPABASE_URL=https://uvtbtpxtrrmaublrztgv.supabase.co
VITE_SUPABASE_URL=https://uvtbtpxtrrmaublrztgv.supabase.co

# Public/publishable key. Safe to expose in the browser; database access is still
# governed by Supabase RLS. Use the current sb_publishable_ key from Supabase.
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# Server-only Supabase secret. Required for trusted server operations.
# Prefer the modern sb_secret_ key. Never use a publishable/anon key here.
SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SECRET_KEY

# Optional legacy fallback. Leave empty when using SUPABASE_SECRET_KEY.
# This must be a legacy service_role JWT, never an anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional extra CORS origins, comma-separated. The production Awesome Adventure Tours domains
# are already allowlisted by the server.
CORS_ALLOWED_ORIGINS=

# Optional server-side Google Gemini integration (/api/chat).
GEMINI_API_KEY=

# Optional Resend email delivery. The booking notification worker starts only
# when BOOKING_NOTIFICATION_WORKER_ENABLED=true and both Resend values are set.
# Each booking email goes to the customer, with a blind copy to this reservation inbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional Svix signing secret used to verify incoming Resend delivery webhooks.
# Keep this server-side only; Resend webhook secrets usually begin with whsec_.
RESEND_WEBHOOK_SECRET=
RESEND_FROM_NAME=Awesome Adventure Tours
RESEND_REPLY_TO=reservation@awesomeadventure.tours
BOOKING_NOTIFICATION_EMAIL=reservation@awesomeadventure.tours
BOOKING_NOTIFICATION_WORKER_ENABLED=false

# Optional WhatsApp Cloud API delivery.
# WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID are required to send.
# WHATSAPP_GRAPH_API_VERSION must use the format vNN.N (for example vXX.X).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
# Optional metadata used by the server's communication configuration response.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_FROM_NUMBER=

# Optional verified official social/profile URLs for Schema.org sameAs (comma-separated HTTPS URLs).
# Leave empty until the business confirms its official profiles.
BRAND_SAME_AS_URLS=
